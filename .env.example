# PostgreSQL
DATABASE_URL=postgres://postgres:password@localhost:5432/fmcg-voice

# LLM provider: "google" or "groq"
AI_PROVIDER=google

# Google AI Studio (Gemini) - https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Groq - https://console.groq.com/keys (chat when AI_PROVIDER=groq, and Whisper as speech-to-text fallback)
GROQ_API_KEY=

# Sarvam - https://dashboard.sarvam.ai (speech-to-text: Saaras, text-to-speech: Bulbul)
SARVAM_API_KEY=

# Optional model overrides
# GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_SUMMARY_MODEL=openai/gpt-oss-20b
# GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# GOOGLE_MODEL=gemini-2.5-flash
# SARVAM_STT_MODEL=saaras:v4
# SARVAM_TTS_MODEL=bulbul:v4-flash
# SARVAM_SPEAKER_EN=simran_en_sales
# SARVAM_SPEAKER_HI=simran_hi_sales
