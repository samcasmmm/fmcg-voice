# PostgreSQL
DATABASE_URL=postgres://postgres:password@localhost:5432/fmcg-voice

# LLM provider: "google" or "groq"
AI_PROVIDER=google

# Google AI Studio (Gemini) - https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Groq - https://console.groq.com/keys (also used for Whisper speech-to-text)
GROQ_API_KEY=
